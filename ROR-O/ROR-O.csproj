<Project Sdk="Microsoft.NET.Sdk">

    <Target Name="PackageThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <PropertyGroup>
            <StagingDir>$(OutDir)Thunderstore_Staging\</StagingDir>
            <PluginDir>$(StagingDir)plugins\ror-o\</PluginDir>
            <ZipFileName>$(OutDir)ROR_O-v1.0.0.zip</ZipFileName>
        </PropertyGroup>

        <RemoveDir Directories="$(StagingDir)"/>
        <MakeDir Directories="$(StagingDir)"/>
        <MakeDir Directories="$(PluginDir)"/>

        <ItemGroup>
            <RootFiles Include="$(ProjectDir)README.md"/>
            <RootFiles Include="$(ProjectDir)manifest.json"/>
            <RootFiles Include="$(ProjectDir)icon.png"/>
        </ItemGroup>

        <ItemGroup>
            <PluginFiles Include="$(TargetPath)"/> </ItemGroup>

        <Copy SourceFiles="@(RootFiles)" DestinationFolder="$(StagingDir)"/>
        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginDir)"/>

        <ZipDirectory SourceDirectory="$(StagingDir)"
                      DestinationFile="$(ZipFileName)"
                      Overwrite="true"/>

        <RemoveDir Directories="$(StagingDir)"/>

        <Message Text="📦 Thunderstore ZIP собран с правильной структурой папок: $(ZipFileName)" Importance="high"/>
    </Target>

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>ROR_O</RootNamespace>
        <Nullable>enable</Nullable>
    </PropertyGroup>

