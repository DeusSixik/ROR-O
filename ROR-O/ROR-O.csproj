<Project Sdk="Microsoft.NET.Sdk" InitialTargets="GenerateModVersion">

    <Import Project="obj\roro.paths.props" Condition="Exists('obj\roro.paths.props')" />
    <Import Project="roro.user.props" Condition="Exists('roro.user.props') and '$(RoroPathsReady)' != 'true'" />

    <PropertyGroup>
        <DeployOnBuild Condition="'$(DeployOnBuild)' == ''">true</DeployOnBuild>
        <GameManagedDir>$(GameDir)\Risk of Rain 2_Data\Managed</GameManagedDir>
        <BepInExCoreDir>$(ProfileDir)\BepInEx\core</BepInExCoreDir>
    </PropertyGroup>

    <Target Name="GenerateModVersion" BeforeTargets="BeforeBuild;CoreCompile" Condition="'$(RoroPathsReady)' == 'true' Or '$(DesignTimeBuild)' == 'true'">
        <Exec Condition="'$(ModVersion)' == ''"
              Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)version.ps1&quot; -Manifest &quot;$(ProjectDir)manifest.json&quot;"
              ConsoleToMSBuild="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="ModVersion" />
        </Exec>
        <PropertyGroup>
            <ModVersion>$([System.String]::Copy('$(ModVersion)').Trim())</ModVersion>
            <Version>$(ModVersion)</Version>
            <AssemblyVersion>$(ModVersion).0</AssemblyVersion>
            <FileVersion>$(ModVersion).0</FileVersion>
            <InformationalVersion>$(ModVersion)</InformationalVersion>
        </PropertyGroup>
        <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ModVersion)', '^[0-9]+\.[0-9]+\.[0-9]+$'))"
               Text="ModVersion must be a three-part version. Got '$(ModVersion)'." />
        <ItemGroup>
            <_ModVersionLine Include="namespace ROR_O" />
            <_ModVersionLine Include="{" />
            <_ModVersionLine Include="    internal static class ModVersionInfo" />
            <_ModVersionLine Include="    {" />
            <_ModVersionLine Include="        public const string Value = &quot;$(ModVersion)&quot;%3B" />
            <_ModVersionLine Include="    }" />
            <_ModVersionLine Include="}" />
        </ItemGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)ModVersion.g.cs"
                          Lines="@(_ModVersionLine)"
                          Overwrite="true"
                          WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)ModVersion.g.cs" />
            <FileWrites Include="$(IntermediateOutputPath)ModVersion.g.cs" />
        </ItemGroup>
    </Target>

    <Target Name="PackageThunderstore" AfterTargets="Build" DependsOnTargets="GenerateModVersion" Condition="'$(Configuration)' == 'Release' and '$(RoroPathsReady)' == 'true'">
        <PropertyGroup>
            <StagingDir>$(OutDir)Thunderstore_Staging\</StagingDir>
            <PluginDir>$(StagingDir)plugins\ror-o\</PluginDir>
            <ZipFileName>$(OutDir)ROR_O-v$(ModVersion).zip</ZipFileName>
        </PropertyGroup>

        <RemoveDir Directories="$(StagingDir)"/>
        <MakeDir Directories="$(StagingDir)"/>
        <MakeDir Directories="$(PluginDir)"/>

        <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)version.ps1&quot; -Manifest &quot;$(ProjectDir)manifest.json&quot; -Version &quot;$(ModVersion)&quot; -Destination &quot;$(StagingDir)manifest.json&quot;" />

        <ItemGroup>
            <RootFiles Include="$(ProjectDir)\..\README.md"/>
            <RootFiles Include="$(ProjectDir)icon.png"/>
        </ItemGroup>

        <ItemGroup>
            <PluginFiles Include="$(TargetPath)"/> </ItemGroup>

        <Copy SourceFiles="@(RootFiles)" DestinationFolder="$(StagingDir)"/>
        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginDir)"/>

        <ZipDirectory SourceDirectory="$(StagingDir)"
                      DestinationFile="$(ZipFileName)"
                      Overwrite="true"/>

        <RemoveDir Directories="$(StagingDir)"/>

        <Message Text="📦 Thunderstore ZIP created: $(ZipFileName)" Importance="high"/>
    </Target>

    <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true' and '$(RoroPathsReady)' == 'true'">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployPluginDir)" />
        <Message Text="Deployed $(TargetFileName) to $(DeployPluginDir)" Importance="high"/>
    </Target>

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <RootNamespace>ROR_O</RootNamespace>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="icon.png">
            <LogicalName>ROR_O.icon.png</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

